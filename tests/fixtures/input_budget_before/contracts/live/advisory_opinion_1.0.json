{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["action","confidence","current_state","game_state","dominant_side","dominance_score","dominance_trend","core_conflict","evidence","invalidation","key_levels","scenario_tree","next_observation_focus","previous_hypothesis_review"],
  "properties":{
    "portfolio_plan":{"type":"object","additionalProperties":false,"required":["portfolio_action","reason"],"properties":{"portfolio_action":{"type":"string","enum":["NONE","OPEN","ADD","REDUCE","EXIT","HOLD"]},"target_weight":{"type":"number","minimum":0,"maximum":1},"reason":{"type":"string"}}},
    "action":{"type":"string","enum":["NO_ACTION","WATCH","WAIT","HOLD","ADD","REDUCE","EXIT"]},
    "confidence":{"type":"integer","minimum":0,"maximum":100},
    "current_state":{"type":"string","minLength":1,"maxLength":2400},
    "game_state":{"oneOf":[{"type":"string","minLength":1,"maxLength":3000},{"type":"object","additionalProperties":false,"required":["summary","buyer_state","seller_state","absorption_state","initiative_side","supply_pressure","demand_strength","price_impact_state"],"properties":{"summary":{"type":"string","minLength":1,"maxLength":1800},"buyer_state":{"type":"string","maxLength":1000},"seller_state":{"type":"string","maxLength":1000},"absorption_state":{"type":"string","maxLength":1000},"initiative_side":{"type":"string","maxLength":200},"supply_pressure":{"type":"string","maxLength":600},"demand_strength":{"type":"string","maxLength":600},"price_impact_state":{"type":"string","maxLength":600}}}]},
